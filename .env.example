# Скопируйте в .env. Значения совпадают с docker-compose.yml.
# Процессы на хосте подключаются к 127.0.0.1. Контейнеры полного compose
# по-прежнему используют имена postgres, redis и minio и этот файл не читают.

# =============================================================================
# Postgres (порт опубликован только на 127.0.0.1)
# =============================================================================
DATABASE_PORT=5432
DATABASE_URL=postgresql://calls:calls@127.0.0.1:5432/calls

# =============================================================================
# Redis
# =============================================================================
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# =============================================================================
# MinIO. media создаёт бакет при старте.
# =============================================================================
MINIO_PORT=9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
S3_BUCKET=recordings

# =============================================================================
# api. SESSION_SECRET не короче 16 символов.
# ADMIN_* нужны, только если в базе ещё нет администратора.
# =============================================================================
SESSION_SECRET=dev-session-secret-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-password
ADMIN_NAME=Администратор
API_PORT=3000

# =============================================================================
# media, transcriber, analyzer, web
# Порт каждого процесса задаётся своей переменной. Скрипт запуска записывает её в PORT.
# =============================================================================
MEDIA_PORT=3001
MEDIA_FETCH_TIMEOUT_MS=10000
MEDIA_CONCURRENCY=4

TRANSCRIBER_PORT=3002
STT_API_URL=
STT_API_KEY=
STT_PROVIDER=
STT_TIMEOUT_MS=120000
TRANSCRIBE_CONCURRENCY=2

ANALYZER_PORT=3003
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=120000
ANALYZE_CONCURRENCY=2

WEB_PORT=3100
