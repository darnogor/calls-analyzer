{
  "name": "calls-analyzer",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/media",
    "apps/transcriber",
    "apps/analyzer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "db:up": "docker compose up -d postgres redis minio",
    "db:down": "docker compose down",
    "dev": "node scripts/local/dev.js",
    "dev:api": "node scripts/local/run-service.js api",
    "dev:media": "node scripts/local/run-service.js media",
    "dev:transcriber": "node scripts/local/run-service.js transcriber",
    "dev:analyzer": "node scripts/local/run-service.js analyzer",
    "dev:web": "node scripts/local/dev-web.js",
    "seed:demo": "npm run seed:demo -w @calls/api"
  },
  "engines": {
    "node": ">=22"
  }
}
